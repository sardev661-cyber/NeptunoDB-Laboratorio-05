<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" /></startup>
  <connectionStrings>
    <add name="Neptuno" connectionString="Data Source=.;Initial Catalog=NeptunoDB;Integrated Security=True;Encrypt=False;TrustServerCertificate=True;Connect Timeout=5" providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>

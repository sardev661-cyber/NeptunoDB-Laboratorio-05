<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Neptuno | Laboratorio 05" Width="1200" Height="810" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13" Background="#F2F5F9">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Padding" Value="15,8"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="MinWidth" Value="95"/></Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="7,5"/><Setter Property="MinHeight" Value="30"/></Style>
        <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="30"/></Style>
        <Style TargetType="DatePicker"><Setter Property="MinHeight" Value="30"/></Style>
        <Style TargetType="TabItem"><Setter Property="Padding" Value="18,10"/></Style>
        <Style TargetType="DataGrid"><Setter Property="Background" Value="White"/><Setter Property="RowHeight" Value="32"/><Setter Property="AlternatingRowBackground" Value="#F2F6FB"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#DFE5EE"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="ColumnHeaderHeight" Value="35"/></Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#173453" Padding="24,15">
            <StackPanel><TextBlock Text="NEPTUNO" FontSize="26" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Laboratorio 05 · WPF y ADO.NET · ExecuteNonQuery" Foreground="#D9E7F5" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Top" Padding="20,10" Background="White">
            <DockPanel><Button x:Name="ConnectButton" Content="Conectar" DockPanel.Dock="Right"/>
                <TextBox x:Name="ConnectionBox" ToolTip="Cadena de conexión de SQL Server" Margin="0,0,10,0"/>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Padding="20,10" Background="#E4EBF3">
            <TextBlock x:Name="GlobalStatus" Text="Configure la conexión y pulse Conectar." TextWrapping="Wrap"/>
        </Border>
        <TabControl x:Name="MainTabs" Margin="18,12"/>
    </DockPanel>
</Window>
